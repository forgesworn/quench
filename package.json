  "version": "0.0.0",
  "private": true,
  "description": "Decide when an agent has gathered enough evidence to stop",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "quench-labels": "src/cli-labels.ts",
    "quench-data": "src/cli-data.ts",
    "quench-score": "src/cli-score.ts",
    "quench-cold": "bin/quench-cold.mjs",
    "quench-estimate": "src/cli-estimate.ts",
    "quench-model": "src/cli-model.ts",
    "quench-hook": "bin/quench-hook.mjs",
    "quench-live-check": "src/cli-live-check.ts",
    "quench-hook-sim": "src/cli-hook-sim.ts",
