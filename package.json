{
  "name": "@forgesworn/quench",
  "version": "0.0.0",
  "private": true,
  "description": "See where your coding agent's spend goes, and when a session should compact",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "quench": "dist/cli.js",
    "quench-report": "dist/cli-report.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "build:plugin": "tsc -p tsconfig.build.json --outDir plugin/dist",
    "prepack": "npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "data": "node src/cli-data.ts",
    "score": "node src/cli-score.ts",
    "estimate": "node src/cli-estimate.ts",
    "report": "node src/cli.ts report"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "5.9.3"
  }
}
